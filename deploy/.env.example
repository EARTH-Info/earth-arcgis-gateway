# Copy to deploy/.env and keep that file out of source control.

EARTHID_AUTHORITY=https://sso.example.gov
EARTHID_AUDIENCE=ei-arcgis-gateway

ARCGIS_BASE_URL=https://gisserver.example.gov
ARCGIS_CREDENTIAL_PROVIDER=federated-11.3
ARCGIS_PORTAL_TOKEN_ENDPOINT=https://portal.example.gov/portal/sharing/rest/generateToken
ARCGIS_FEDERATED_SERVER_URL=https://gisserver.example.gov/arcgis
ARCGIS_USERNAME=
ARCGIS_PASSWORD=

# Used only when ARCGIS_CREDENTIAL_PROVIDER=oauth-11.5
ARCGIS_OAUTH_TOKEN_ENDPOINT=https://portal.example.gov/portal/sharing/rest/oauth2/token
ARCGIS_OAUTH_CLIENT_ID=
ARCGIS_OAUTH_CLIENT_SECRET=
ARCGIS_OAUTH_EXCHANGE_FOR_FEDERATED_SERVER=true

ARCGIS_ALLOWED_PATH_PREFIX=/arcgis/rest/services/ApprovedFolder/

# Base deployment registers only the application being piloted.
# Add GeoForest or other applications later through deployment-specific
# environment/Compose overrides rather than supplying dummy registrations.
JTUWMA_AUDIENCE=ei-arcgis-gateway
JTUWMA_CLIENT_ID=jtuwma-web
JTUWMA_ACCESS_API_AUTHORIZE_URL=https://jtuwma.example.gov/api/gateway/authorize

# ClickHouse is required for the supplied Production deployment and must use HTTPS.
# For local Development without persistence, run the app outside this Production Compose profile.
CLICKHOUSE_BASE_URL=https://clickhouse.example.gov:8443
CLICKHOUSE_DATABASE=default
CLICKHOUSE_TABLE=gateway_telemetry
CLICKHOUSE_USERNAME=
CLICKHOUSE_PASSWORD=

# Separate EarthID confidential OIDC client for the browser Admin Console.
# Register https://<gateway-host>/signin-oidc as an allowed redirect URI.
GATEWAY_ADMIN_OIDC_CLIENT_ID=
GATEWAY_ADMIN_OIDC_CLIENT_SECRET=

# Stable EarthID sub for initial break-glass/initial gateway administrator.
GATEWAY_ADMIN_SUBJECT=

# EarthID role claims used by the tiered Admin Console RBAC model.
GATEWAY_ADMIN_VIEWER_ROLE=gateway-viewer
GATEWAY_ADMIN_SECURITY_OPERATOR_ROLE=gateway-security-operator
GATEWAY_ADMINISTRATOR_ROLE=gateway-admin

# IP address of the reverse proxy/load balancer directly in front of the gateway.
# Leave blank only when requests connect directly and forwarded headers are not used.
TRUSTED_PROXY_IP=
